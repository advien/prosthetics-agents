# ── LLM per agent role ───────────────────────────────────────────────────────
# Leave everything unset -> deterministic mock, no network, no cost.
# Format: provider/model  (CrewAI native providers). See CONNECTIONS.md for keys.
#
# LLM_DEFAULT applies to every role that has no LLM_<ROLE> override.

# --- Free-tier development profile (Gemini) ---
# LLM_DEFAULT=gemini/gemini-2.5-flash
# GEMINI_API_KEY=

# --- Free-tier via Groq (OpenAI-compatible endpoint) ---
# LLM_DEFAULT=hosted_vllm/llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=

# --- Final-demo profile: model per role (cost/latency-aware) ---
# LLM_INTAKE=anthropic/claude-haiku-4-5
# LLM_BIOMECH=anthropic/claude-sonnet-5
# LLM_RECOMMENDATION=anthropic/claude-sonnet-5
# LLM_SAFETY=anthropic/claude-opus-5
# LLM_DOCUMENTATION=anthropic/claude-haiku-4-5
# ANTHROPIC_API_KEY=

# --- Mixed providers (what the portfolio narrative is about) ---
# LLM_INTAKE=gemini/gemini-2.5-flash
# LLM_RECOMMENDATION=openai/gpt-5-mini
# LLM_SAFETY=anthropic/claude-opus-5
# OPENAI_API_KEY=

# --- Local, no key: Ollama ---
# LLM_DEFAULT=ollama/llama3.1:8b
# OLLAMA_HOST=http://localhost:11434/v1

# --- Own OpenAI-compatible server (vLLM / llama.cpp / Cloudflare Workers AI gateway) ---
# LLM_DOCUMENTATION=hosted_vllm/<model-name>
# LLM_DOCUMENTATION_BASE_URL=http://<host>:8000/v1
# LLM_DOCUMENTATION_API_KEY=dummy

# ── CrewAI housekeeping ──────────────────────────────────────────────────────
CREWAI_DISABLE_TELEMETRY=true
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
